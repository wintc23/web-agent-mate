{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_appName__",
  "version": "0.2.2",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["identity", "storage", "sidePanel", "nativeMessaging", "scripting", "tabs"],
  "host_permissions": [
    "https://www.orcarouter.ai/*",
    "https://api.orcarouter.ai/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open WebAgentMate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
